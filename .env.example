# .env.example: environment sample for the backend
#
# Description:
# Local-development sample for the backend. It contains placeholder values
# only: copy it to .env, replace the values, and never commit real values
# (.env is ignored). It is not required for npm run demo, because the local
# demo (APP_MODE=local) needs no .env file.
#
# The backend and the Prisma CLI read the process environment and do not load
# .env themselves, so the file is exported into the shell before running them.
# This sample is not the source of truth: doc/CONFIGURATION.md and
# backend/src/common/config.ts define every setting, default, and validation
# rule.
#
# Author: id774 (More info: https://id774.net)
# Source Code: https://github.com/id774/spa-reference
# License: The GPL version 3, or LGPL version 3 (Dual License).
# Contact: idnanashi@gmail.com
#
# Usage:
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# Requirements:
# - Node.js 24 or later (backend and Prisma CLI)

# Not required for npm run demo. The local demo (APP_MODE=local) needs no .env file.
#
# --- Application mode -------------------------------------------------------
# aws (default): Cognito, S3, SES, and SNS; every AWS value below is required.
# local: the no-cloud demo adapters; see doc/GETTING_STARTED.md, section 4.
APP_MODE=aws

# --- Database (required) ---------------------------------------------------
# Either DATABASE_URL, or DB_HOST + DB_NAME + DB_USERNAME + DB_PASSWORD (+ DB_PORT).
# DATABASE_URL wins when both are present.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spa_reference
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=spa_reference
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# --- Cognito (required) ----------------------------------------------------
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_EXAMPLE
COGNITO_CLIENT_ID=example-spa-client-id
COGNITO_USERINFO_ENDPOINT=https://example-prefix.auth.ap-northeast-1.amazoncognito.com/oauth2/userInfo

# --- AWS services (required) -----------------------------------------------
# Credentials come from the standard AWS SDK chain (environment or profile).
AWS_REGION=ap-northeast-1
S3_BUCKET=example-attachment-bucket
SES_SENDER=noreply@example.com
SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-1:111111111111:example-topic

# --- Optional (the defaults below are what the code uses when unset) ---------
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# ATTACHMENT_MAX_BYTES=10485760
# OUTBOX_POLL_INTERVAL_MS=5000
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_RETRY_DELAYS_SECONDS=30,120,600,1800
# OUTBOX_CLAIM_LEASE_SECONDS=60
# OUTBOX_PROVIDER_TIMEOUT_MS=15000
# OUTBOX_BATCH_SIZE=10

# --- Capability routing ------------------------------------------------------
# "local" is the only supported mode; any other value fails start-up.
# CAPABILITY_REQUESTS_MODE=local
# CAPABILITY_APPROVALS_MODE=local
# CAPABILITY_ATTACHMENTS_MODE=local
# CAPABILITY_AUDIT_MODE=local

# --- Backend tests (read by the test suite, not by the application) ----------
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spa_test
